API_BASE_URL=https://localhost:44312/api/
API_AUTHORITY=https://localhost:44367
API_CLIENT_ID=ClassifiedAds.WebMVC
API_CLIENT_SECRET=
API_USERNAME=
API_PASSWORD=
API_SCOPE=ClassifiedAds.WebAPI
# Set 1 only against a disposable development/test backend.
API_ALLOW_WRITES=0
# Only for local self-signed certificates.
API_IGNORE_HTTPS_ERRORS=0
# Optional bearer token instead of the .NET suite's password grant:
# API_ACCESS_TOKEN=
# Optional explicit configuration fallback (path relative to this package):
# API_DOTNET_SETTINGS=../dotnet/ClassifiedAds.ApiIntegrationTests/appsettings.json
# Conversion service must be available; otherwise this test fails with the HTTP status.
API_TEST_PDF=1
# Both values are required to trigger account emails. Use a test mail sink.
API_ALLOW_EMAILS=0
API_TEST_EMAIL=
