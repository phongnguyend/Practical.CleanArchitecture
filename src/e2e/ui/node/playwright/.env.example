# Copy to .env (ignored by Git), or supply environment variables in CI.
E2E_USERNAME=
E2E_PASSWORD=
E2E_ANGULAR_URL=http://localhost:4200
E2E_REACTJS_URL=http://localhost:3000
E2E_VUEJS_URL=http://localhost:8080
E2E_API_URL=https://localhost:44312/api/
E2E_START_SERVERS=1
# Enable only for a disposable development backend; tests create and delete fixtures.
E2E_ALLOW_WRITES=0
# Local self-signed development certificates only. Keep 0 for deployed environments.
E2E_IGNORE_HTTPS_ERRORS=0
# Optional: enable the PDF test when the conversion service is configured.
E2E_PDF=0
# Optional asset forwarding only; OIDC callback redirects may bypass it.
# Prefer a free registered origin; see the Vue overrides in README.md.
# E2E_VUEJS_SERVER_URL=http://localhost:8082
# E2E_WORKERS=3

# Next.js uses cookie authentication and shares React's default registered origin.
# Select it instead of React; stop React on port 3000 before starting Next.js.
# E2E_APPS=nextjs
# E2E_NEXTJS_URL=http://localhost:3000

# BFF React: start ReverseProxy.Yarp separately; Vite is managed by this suite.
# E2E_APPS=bff-reactjs
# E2E_BFF_REACTJS_URL=https://localhost:44348
# E2E_BFF_REACTJS_DEV_URL=http://localhost:3000

# Optional separate report directory for each verification run (keep ignored):
# E2E_ARTIFACTS_DIR=playwright-report/verification
