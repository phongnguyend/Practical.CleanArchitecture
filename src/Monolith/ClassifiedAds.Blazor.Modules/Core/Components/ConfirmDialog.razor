<Dialog IsOpen="@ShowDialog" Title="@Title">
    <DialogHeader Title="@Title" OnClose="Close" />
    <DialogBody>
        <div class="form-group">
            @Message
        </div>
    </DialogBody>
    <DialogFooter>
        <button type="submit" @onclick="@HandleValidSubmit" class="btn btn-primary"><ActionIcon Name="check" /> @YesText</button>
        <a class="btn btn-outline-primary" @onclick="@Close"><ActionIcon Name="x" /> @NoText</a>
    </DialogFooter>
</Dialog>
