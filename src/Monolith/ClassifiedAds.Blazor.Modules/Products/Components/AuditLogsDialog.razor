<Dialog IsOpen="@ShowDialog" Title="Audit Logs" Size="xl">
    <DialogHeader Title="Audit Logs" OnClose="Close" />
    <DialogBody>

        @if (AuditLogs == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Date Time</th>
                        <th>User Name</th>
                        <th>Action</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in AuditLogs)
                    {
                        <tr>
                            <td>@log.CreatedDateTime.</td>
                            <td>@log.UserName</td>
                            <td>@log.Action</td>
                            <td style="color:@(log.HighLight["code"] ? "red" : "")">
                                @log.Data.Code
                            </td>
                            <td style="color:@(log.HighLight["name"] ? "red" : "")">
                                @log.Data.Name
                            </td>
                            <td style="color:@(log.HighLight["description"] ? "red" : "")">
                                @log.Data.Description
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </DialogBody>
</Dialog>
