{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Yarp": {
    "Routes": {
      "products": {
        "ClusterId": "Products",
        "Match": {
          "Path": "/api/products/{**remainder}"
        }
      },
      "files": {
        "ClusterId": "Files",
        "Match": {
          "Path": "/api/files/{**remainder}"
        }
      },
      "auditLogEntries": {
        "ClusterId": "AuditLogs",
        "Match": {
          "Path": "/api/auditLogEntries/{**remainder}"
        }
      },
      "users": {
        "ClusterId": "Users",
        "Match": {
          "Path": "/api/users/{**remainder}"
        }
      },
      "ConfigurationEntries": {
        "ClusterId": "Configurations",
        "Match": {
          "Path": "/api/ConfigurationEntries/{**remainder}"
        }
      },
      "hubs": {
        "ClusterId": "Hubs",
        "Match": {
          "Path": "/hubs/{**remainder}"
        }
      }
    },
    "Clusters": {
      "Products": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44328"
          }
        }
      },
      "Files": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44345"
          }
        }
      },
      "AuditLogs": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44378"
          }
        }
      },
      "Users": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44306"
          }
        }
      },
      "Configurations": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44301"
          }
        }
      },
      "Hubs": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44390"
          }
        }
      }
    }
  }
}
