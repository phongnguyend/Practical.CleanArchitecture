    "@capacitor/browser": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capgo/capacitor-native-biometric": "8.9.3",
    "@microsoft/signalr": "^10.0.11",
    "@reduxjs/toolkit": "^2.14.0",
    "@sentry/capacitor": "4.6.0",
    "@sentry/react": "10.76.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.8",
    "lucide-react": "^1.71.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "redux": "^5.0.1",
    "redux-saga": "^1.5.1"
