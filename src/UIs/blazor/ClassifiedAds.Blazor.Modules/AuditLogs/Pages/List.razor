@page "/auditlogs"
@attribute [Authorize]

<div class="card">
    <div class="card-header">
        Audit Logs
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <div style="float: right">
            <Pagination TotalItems="TotalItems" PageSize="PageSize" CurrentPage="CurrentPage" PageChanged="GetAuditLogsAsync"></Pagination>
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Date Time</th>
                        <th>User Name</th>
                        <th>Action</th>
                        <th>Data</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var auditLog in AuditLogs)
                    {
                        <tr>
                            <td>
                                @auditLog.CreatedDateTime
                            </td>
                            <td>@auditLog.UserName</td>
                            <td><AuditAction Action="@auditLog.Action" /></td>
                            <td>
                                <div class="audit-data-actions">
                                    <div>
                                        <button type="button" class="app-json-trigger" title="View JSON" aria-label="View JSON" @onclick="() => ViewJson(auditLog.Log)">{ }</button>
                                        <CopyToClipboard Text="@auditLog.Log" />
                                    </div>
                                </div>
                                <div class="audit-data-preview">@auditLog.Log</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="float: right">
            <Pagination TotalItems="TotalItems" PageSize="PageSize" CurrentPage="CurrentPage" PageChanged="GetAuditLogsAsync"></Pagination>
            </div>
        </div>
    </div>
</div>

<span data-page-loaded="@IsLoaded.ToString().ToLowerInvariant()" hidden></span>

<JsonViewer JsonData="@SelectedJson" @bind-IsOpen="IsJsonOpen" />
