<span class="badge" data-action="@Kind">@Label</span>

@code {
    [Parameter]
    public string Action { get; set; }

    private string Label => FormatAuditAction(Action);

    private string Kind => System.Text.RegularExpressions.Regex.Split(Label.ToUpperInvariant(), @"[_\s-]")[0];

    private static string FormatAuditAction(string action)
    {
        return string.IsNullOrWhiteSpace(action) ? "Event" : action.Trim().Replace('_', ' ');
    }
}
